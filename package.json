{
  "name": "dsh-pet-luotianyi",
  "version": "1.3.4",
  "description": "洛天依桌宠：住在 DSH 里的虚拟歌姬，可拖动、可互动；台词支持预设/AI 两种模式，内置 token 用量与费用统计栏，支持换图 + AI 自动抠图与预览微调。",
  "type": "module",
  "main": "./lib/pet-host.js",
  "exports": {
    ".": { "default": "./lib/pet-host.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/pet-host.js",
    "lib/client.js",
    "lib/cut-worker.mjs",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "mascot",
    "luotianyi",
    "洛天依",
    "virtual-singer",
    "background-removal",
    "cutout",
    "image-import"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  }
}
